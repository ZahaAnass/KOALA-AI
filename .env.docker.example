# Copy to `.env` at the repository root. Docker Compose reads it for client build arguments.
# Runtime server settings live in `server/.env` (see server/.env.example).

# Leave empty so the nginx container proxies /api to the server service.
# Set to a public URL (e.g. https://api.example.com) only when the API is hosted elsewhere.
VITE_API_URL=

# Clerk publishable key baked into the client bundle at build time.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
