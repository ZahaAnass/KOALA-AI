# ---- Server ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# ---- Database ----
MONGO_URI=mongodb://localhost:27017/koala-ai
# Atlas example: mongodb+srv://user:password@cluster.mongodb.net/koala-ai?retryWrites=true&w=majority

# ---- Auth (Clerk) ----
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Optional: enables POST /api/webhooks/clerk user sync
CLERK_WEBHOOK_SECRET=whsec_xxx

# ---- AI providers ----
# Required for chat, image generation, embeddings and web search grounding
GEMINI_API_KEY=your_gemini_api_key
# Optional: adds GPT-4o models to the model picker
OPENAI_API_KEY=
DEFAULT_MODEL=gemini-2.5-flash

# ---- Image uploads (ImageKit). Optional; uploads are disabled when missing ----
IMAGE_KIT_END_POINT=https://ik.imagekit.io/your_id
IMAGE_KIT_PUBLIC_KEY=public_xxx
IMAGE_KIT_PRIVATE_KEY=private_xxx

# ---- Limits & roles ----
# Comma-separated emails that are granted the admin role automatically
ADMIN_EMAILS=
DAILY_MESSAGE_QUOTA=200
MAX_HISTORY_MESSAGES=400
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
